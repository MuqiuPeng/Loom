{# Monospace body, exposed grid rules, specifications rather than marketing. #}
{% extends "_base.html.j2" %}
{% block style %}
body{background:#e8e6e1;color:#1d1c1a;
  font-family:'SF Mono',Menlo,Consolas,monospace;font-size:.92rem}
.hero{padding:3.5rem 1.5rem 2rem;border-bottom:1px solid #1d1c1a}
h1{font-family:'Helvetica Neue',Arial,sans-serif;text-transform:uppercase;
  font-size:clamp(2rem,7vw,4rem);letter-spacing:-.02em;font-weight:700;margin:0}
.lede{margin-top:1rem;max-width:38rem}
.band{border-bottom:1px solid rgba(0,0,0,.25);padding:2.5rem 0}
h2{font-size:.7rem;text-transform:uppercase;letter-spacing:.2em;
  margin:0 0 1.2rem;opacity:.6}
h3{font-size:.8rem;text-transform:uppercase;letter-spacing:.12em;
  margin:1.6rem 0 .5rem;color:{{ palette.accent }}}
.item{border-bottom:1px solid rgba(0,0,0,.12)}
.item .dots{border:0}
.gallery img{filter:grayscale(.2)}
.facts-grid{display:grid;gap:2rem}
@media(min-width:700px){.facts-grid{grid-template-columns:1fr 1fr}}
{% endblock %}
