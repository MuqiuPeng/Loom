{# Cool, low-saturation, one readable column, large tap targets. #}
{% extends "_base.html.j2" %}
{% block style %}
body{background:#fbfcfd;color:#22303a;font-size:17px;
  font-family:-apple-system,'Segoe UI',Helvetica,sans-serif}
.wrap{max-width:44rem}
.hero{padding:3.5rem 1.5rem 2rem;max-width:44rem;margin:0 auto}
h1{font-size:clamp(2rem,6vw,3.2rem);font-weight:650;letter-spacing:-.02em;margin:0}
.lede{margin-top:1.1rem;opacity:.8}
.hero-img{margin-top:2rem;border-radius:8px}
h2{font-size:.78rem;text-transform:uppercase;letter-spacing:.14em;
  opacity:.55;margin:0 0 1rem}
h3{font-size:1rem;font-weight:650;margin:1.6rem 0 .5rem}
.band{padding:2.5rem 0;border-top:1px solid rgba(34,48,58,.1)}
.facts-grid{display:grid;gap:1.5rem}
.facts p{font-size:1.15rem}
.facts a{display:inline-block;padding:.7rem 1.2rem;margin-top:.5rem;
  background:{{ palette.accent }};color:#fff;border-radius:8px;
  text-decoration:none;font-weight:600}
{% endblock %}
